# ---------------------------------------------------------------
# Copy this file to a new file named ".env" (same folder).
# WampServer default: user "root" with an EMPTY password.
# If your MySQL port is not 3306, change it below (see SETUP-DATABASE.md).
# ---------------------------------------------------------------

# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:@127.0.0.1:3306/farhang_school"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Auth (used from the next steps; change the secret to any long random text)
JWT_SECRET="change-this-to-a-long-random-text"
JWT_EXPIRES_IN="7d"
